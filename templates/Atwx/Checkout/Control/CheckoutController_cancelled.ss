<div class="checkout checkout--cancelled">
    <h1><%t Atwx\Checkout.CancelledTitle 'Zahlung nicht abgeschlossen' %></h1>
    <p><%t Atwx\Checkout.CancelledText 'Ihre Zahlung wurde nicht abgeschlossen. Bestellnummer:' %> <strong>$Order.OrderNumber</strong></p>
    <p><%t Atwx\Checkout.CancelledRetry 'Sie können den Bezahlvorgang erneut starten.' %></p>
</div>
